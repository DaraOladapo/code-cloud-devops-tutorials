@model ToDoApp.Models.TodoItem

@{
    ViewData["Title"] = "Task Details";
}

<div class="main-container">
    <!-- Header Section -->
    <div class="header-section">
        <h1><i class="bi bi-eye"></i> Task Details</h1>
        <p>View complete task information</p>
    </div>

    <div class="stats-card">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div class="flex-grow-1">
                <h2 class="task-title @(Model.IsComplete ? "text-decoration-line-through text-muted" : "")">
                    @Model.Title
                </h2>
                
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="lead text-muted">@Model.Description</p>
                }
            </div>
            
            @if (Model.IsComplete)
            {
                <span class="badge bg-success fs-6">
                    <i class="bi bi-check-circle"></i> Completed
                </span>
            }
            else
            {
                <span class="badge bg-warning fs-6">
                    <i class="bi bi-clock"></i> Pending
                </span>
            }
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <h6><i class="bi bi-exclamation-triangle"></i> Priority</h6>
                <span class="priority-badge priority-@Model.Priority.ToString().ToLower() fs-6">
                    @Model.Priority
                </span>
            </div>

            @if (!string.IsNullOrEmpty(Model.Category))
            {
                <div class="col-md-6">
                    <h6><i class="bi bi-tag"></i> Category</h6>
                    <span class="badge bg-light text-dark fs-6">@Model.Category</span>
                </div>
            }

            @if (Model.DueDate.HasValue)
            {
                <div class="col-md-6">
                    <h6><i class="bi bi-calendar"></i> Due Date</h6>
                    <span class="badge @(Model.DueDate < DateTime.UtcNow && !Model.IsComplete ? "bg-danger" : "bg-info") fs-6">
                        @Model.DueDate.Value.ToString("MMMM dd, yyyy 'at' h:mm tt")
                        @if (Model.DueDate < DateTime.UtcNow && !Model.IsComplete)
                        {
                            <span class="ms-1">(Overdue)</span>
                        }
                    </span>
                </div>
            }

            <div class="col-md-6">
                <h6><i class="bi bi-calendar-plus"></i> Created</h6>
                <span class="text-muted">@Model.CreatedAt.ToString("MMMM dd, yyyy 'at' h:mm tt")</span>
            </div>

            @if (Model.IsComplete && Model.CompletedAt.HasValue)
            {
                <div class="col-md-6">
                    <h6><i class="bi bi-check-circle"></i> Completed</h6>
                    <span class="text-success">@Model.CompletedAt.Value.ToString("MMMM dd, yyyy 'at' h:mm tt")</span>
                </div>
            }
        </div>

        @if (Model.DueDate.HasValue)
        {
            <div class="mt-4">
                <h6><i class="bi bi-hourglass"></i> Time Information</h6>
                <div class="row">
                    @if (!Model.IsComplete)
                    {
                        var timeRemaining = Model.DueDate.Value - DateTime.UtcNow;
                        <div class="col-md-6">
                            @if (timeRemaining.TotalDays > 0)
                            {
                                <span class="text-info">@((int)timeRemaining.TotalDays) days remaining</span>
                            }
                            else if (timeRemaining.TotalHours > 0)
                            {
                                <span class="text-warning">@((int)timeRemaining.TotalHours) hours remaining</span>
                            }
                            else if (timeRemaining.TotalMinutes > 0)
                            {
                                <span class="text-danger">@((int)timeRemaining.TotalMinutes) minutes remaining</span>
                            }
                            else
                            {
                                <span class="text-danger">Overdue!</span>
                            }
                        </div>
                    }
                    else
                    {
                        var completionTime = Model.CompletedAt!.Value - Model.CreatedAt;
                        <div class="col-md-6">
                            <span class="text-success">
                                Completed in @((int)completionTime.TotalDays) days, @((int)completionTime.Hours) hours
                            </span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Action Buttons -->
        <div class="mt-4 d-flex flex-wrap gap-2">
            @if (!Model.IsComplete)
            {
                <form asp-action="Complete" asp-route-id="@Model.Id" method="post" style="display:inline">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check"></i> Mark Complete
                    </button>
                </form>
            }
            else
            {
                <form asp-action="Complete" asp-route-id="@Model.Id" method="post" style="display:inline">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-arrow-clockwise"></i> Mark Pending
                    </button>
                </form>
            }

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit Task
            </a>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline">
                <button type="submit" class="btn btn-danger" 
                        onclick="return confirm('Are you sure you want to delete this task?')">
                    <i class="bi bi-trash"></i> Delete Task
                </button>
            </form>

            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>
